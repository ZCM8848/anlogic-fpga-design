# 默认按文本处理，仓库内统一使用 LF
* text=auto eol=lf

# HDL / 工程 / 约束：文本，强制 LF
*.v      text eol=lf
*.vh     text eol=lf
*.sv     text eol=lf
*.vhd    text eol=lf
*.al     text eol=lf
*.adc    text eol=lf
*.cst    text eol=lf
*.sdc    text eol=lf
*.f      text eol=lf
*.tcl    text eol=lf

# 二进制：禁止换行符转换与 diff
*.pdf    binary
*.docx   binary
*.xlsx   binary
*.bit    binary
*.db     binary
*.bin    binary
*.fs     binary
*.mif    -text
